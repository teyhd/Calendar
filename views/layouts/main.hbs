<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head}}
</head>
<body>
    {{> navbar}}

    <main class="app-main">
        {{{body}}}
    </main>

    <dialog class="app-dialog" id="eventModal" aria-labelledby="eventModalLabel">
        <section class="app-dialog-panel">
            <header class="app-dialog-head">
                <h2 class="app-dialog-title" id="eventModalLabel">Мероприятие</h2>
                <button class="app-icon-button" type="button" data-dialog-close aria-label="Закрыть">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </header>
            <div class="app-dialog-body" id="eventModalBody">
                <div class="app-modal-loading"><span class="app-spinner" aria-hidden="true"></span><div>Загрузка информации…</div></div>
            </div>
            <footer class="app-dialog-foot" id="eventModalFooter">
                <span></span><button type="button" class="app-btn app-btn-secondary" data-dialog-close>Закрыть</button>
            </footer>
        </section>
    </dialog>

    <dialog class="app-dialog" id="reasonModal" aria-labelledby="reasonModalLabel">
        <section class="app-dialog-panel">
            <header class="app-dialog-head">
                <h2 class="app-dialog-title" id="reasonModalLabel">Укажите причину</h2>
                <button class="app-icon-button" type="button" data-dialog-close aria-label="Закрыть">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </header>
            <div class="app-dialog-body">
                <form id="reasonForm">
                    <input type="hidden" id="reasonAction" name="action" value="">
                    <input type="hidden" id="reasonEventId" name="eventId" value="">
                    <div class="app-field">
                        <label class="app-label" for="reasonText">Причина <span class="app-help">(необязательно)</span></label>
                        <textarea class="app-textarea" id="reasonText" name="reason" rows="4" placeholder="Коротко опишите причину действия"></textarea>
                        <p class="app-help">Если оставить поле пустым, система использует стандартную формулировку.</p>
                    </div>
                </form>
            </div>
            <footer class="app-dialog-foot">
                <button type="button" class="app-btn app-btn-secondary" data-dialog-close>Отмена</button>
                <button type="button" class="app-btn app-btn-danger" id="submitReasonBtn">Подтвердить</button>
            </footer>
        </section>
    </dialog>

    <dialog class="app-dialog" id="reviewModal" aria-labelledby="reviewModalLabel">
        <section class="app-dialog-panel">
            <header class="app-dialog-head">
                <h2 class="app-dialog-title" id="reviewModalLabel">Отзыв о мероприятии</h2>
                <button class="app-icon-button" type="button" data-dialog-close aria-label="Закрыть">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
                </button>
            </header>
            <div class="app-dialog-body">
                <form id="reviewForm">
                    <input type="hidden" id="reviewEventId" name="eventId" value="">
                    <div class="app-field">
                        <label class="app-label" for="reviewText">Текст отзыва</label>
                        <textarea class="app-textarea" id="reviewText" name="review_text" rows="5" placeholder="Опишите результат или впечатления"></textarea>
                        <p class="app-help">Отзыв будет виден организатору и в общем списке отзывов.</p>
                    </div>
                </form>
            </div>
            <footer class="app-dialog-foot">
                <button type="button" class="app-btn app-btn-secondary" data-dialog-close>Отмена</button>
                <button type="button" class="app-btn app-btn-primary" id="submitReviewBtn">Сохранить отзыв</button>
            </footer>
        </section>
    </dialog>

    <dialog class="app-dialog app-dialog-side" id="eventComposer" aria-labelledby="eventComposerLabel">
        <section class="app-dialog-panel">
            <header class="app-dialog-head">
                <div><p class="app-page-kicker" id="eventComposerKicker">Мероприятие</p><h2 class="app-dialog-title" id="eventComposerLabel">Создать мероприятие</h2></div>
                <button class="app-icon-button" type="button" data-dialog-close aria-label="Закрыть"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
            </header>
            <div class="app-dialog-body" id="eventComposerBody"><div class="app-modal-loading"><span class="app-spinner" aria-hidden="true"></span><div>Загрузка формы…</div></div></div>
        </section>
    </dialog>

    <dialog class="app-dialog app-dialog-wide" id="workspacePanel" aria-labelledby="workspacePanelLabel">
        <section class="app-dialog-panel">
            <header class="app-dialog-head">
                <h2 class="app-dialog-title" id="workspacePanelLabel">Рабочий раздел</h2>
                <button class="app-icon-button" type="button" data-dialog-close aria-label="Закрыть"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
            </header>
            <div class="app-dialog-body" id="workspacePanelBody"></div>
        </section>
    </dialog>

    <script src="/vendor/fullcalendar/index.global.min.js"></script>
    <script src="/vendor/chart.js/chart.umd.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/calendar.js"></script>
    <script src="/js/workspace.js"></script>
</body>
</html>

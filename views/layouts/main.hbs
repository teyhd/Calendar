<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head}}
</head>
<body>
    {{> navbar}}

    <main class="container mt-4">
        {{{body}}}
    </main>

    <!-- ============ МОДАЛЬНОЕ ОКНО (ГЛОБАЛЬНОЕ) ============ -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">📌 Мероприятие</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body" id="eventModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <p class="mt-2 text-muted">Загрузка...</p>
                    </div>
                </div>
                <div class="modal-footer" id="eventModalFooter">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>
    <!-- ======================================================= -->

    <!-- ============ МОДАЛКА ДЛЯ ПРИЧИНЫ ОТМЕНЫ/ОТКЛОНЕНИЯ ============ -->
    <div class="modal fade" id="reasonModal" tabindex="-1" aria-labelledby="reasonModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reasonModalLabel">📝 Укажите причину</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <form id="reasonForm">
                        <input type="hidden" id="reasonAction" name="action" value="">
                        <input type="hidden" id="reasonEventId" name="eventId" value="">
                        <input type="hidden" id="reasonEndpoint" name="endpoint" value="">
                        
                        <div class="mb-3">
                            <label for="reasonText" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">
                                Причина <span class="text-muted">(необязательно)</span>
                            </label>
                            <textarea class="form-control" id="reasonText" name="reason" rows="3" 
                                      placeholder="Укажите причину отмены/отклонения мероприятия..." 
                                      style="resize: vertical;"></textarea>
                            <div class="form-text text-muted small">
                                Если не указать причину, будет использовано значение по умолчанию.
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary" id="submitReasonBtn">
                        <i class="bi bi-check-lg me-1"></i> Подтвердить
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================================================ -->

    <!-- ============ МОДАЛКА ДЛЯ ОТЗЫВА ============ -->
    <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewModalLabel">📝 Отзыв о мероприятии</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <form id="reviewForm">
                        <input type="hidden" id="reviewEventId" name="eventId" value="">
                        <div class="mb-3">
                            <label for="reviewText" class="form-label fw-semibold">Текст отзыва</label>
                            <textarea class="form-control" id="reviewText" name="review_text" rows="5" placeholder="Напишите краткий отзыв или резолюцию по итогам мероприятия..."></textarea>
                            <div class="form-text text-muted small">
                                Отзыв будет виден организатору и в общем списке отзывов.
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary" id="submitReviewBtn">Сохранить отзыв</button>
                </div>
            </div>
        </div>
    </div>
    <!-- ============================================================ -->

    <!-- Скрипты -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/6.1.8/index.global.min.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/calendar.js"></script>
</body>
</html>
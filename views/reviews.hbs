<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    📋 Отзывы о мероприятиях
</h1>

{{#if reviews.length}}
    <div class="row g-4">
        {{#each reviews}}
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                        <h5 class="mb-1">{{title}}</h5>
                        <small class="text-muted">Организатор: {{creator_name}}</small>
                    </div>
                    <div class="card-body">
                        <p class="card-text">{{review_text}}</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <small class="text-muted">
                                <i class="bi bi-person"></i> {{reviewer_name}}
                            </small>
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> {{formatDate review_created_at}}
                            </small>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a href="/events/archive" class="btn btn-sm btn-outline-primary">Перейти в архив</a>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="alert alert-info border-0 shadow-sm" style="border-radius: 0.75rem;">
        <p class="mb-0">Нет отзывов о мероприятиях.</p>
    </div>
{{/if}}

<div class="mt-4">
    <a href="/" class="btn btn-primary">← На главную</a>
</div>
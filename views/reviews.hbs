<section class="app-page-head"><div><p class="app-page-kicker">Обратная связь</p><h1 class="app-page-title">Отзывы</h1><p class="app-page-summary">Итоги завершённых мероприятий от участников и организаторов.</p></div><a class="app-btn app-btn-secondary" href="/events/archive">Открыть архив</a></section>
{{#if reviews.length}}
<section class="app-event-list" aria-label="Отзывы о мероприятиях">
    {{#each reviews}}<article class="app-event-row"><div><span class="app-event-title">{{title}}</span><span class="app-event-description">{{review_text}}</span></div><div class="app-event-meta"><span>Организатор: {{creator_name}}</span></div><div class="app-event-meta"><span>{{reviewer_name}}</span><span>{{formatDate review_created_at}}</span></div><div><a class="app-btn app-btn-secondary app-btn-sm" href="/events/archive">К мероприятию</a></div></article>{{/each}}
</section>
{{else}}<section class="app-surface app-empty"><h2>Отзывов пока нет</h2><p>Они появятся после завершения мероприятий.</p></section>{{/if}}

<h1 class="mb-4">👥 Управление пользователями</h1>

<!-- Форма добавления пользователя -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">➕ Добавить пользователя</h5>
    </div>
    <div class="card-body">
        <form action="/admin/users/create" method="POST" class="row g-3">
            <div class="col-md-3">
                <input type="text" class="form-control" name="full_name" placeholder="ФИО" required>
            </div>
            <div class="col-md-3">
                <input type="email" class="form-control" name="email" placeholder="Email" required>
            </div>
            <div class="col-md-2">
                <input type="text" class="form-control" name="password" placeholder="Пароль" required>
            </div>
            <div class="col-md-2">
                <select class="form-select" name="role">
                    <option value="student">Ученик</option>
                    <option value="teacher">Учитель</option>
                    <option value="parent">Родитель</option>
                    <option value="admin">Администратор</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-success w-100">➕</button>
            </div>
            <div class="col-md-1">
                <button type="reset" class="btn btn-secondary w-100">✖</button>
            </div>
        </form>
    </div>
</div>

<!-- Список пользователей -->
<div class="card shadow">
    <div class="card-header bg-primary text-white">
        <span>Список пользователей</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ФИО</th>
                        <th>Email</th>
                        <th>Роль</th>
                        <th>Класс</th>
                        <th>Кафедра</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                        <tr>
                            <td>{{id}}</td>
                            <td>{{full_name}}</td>
                            <td>{{email}}</td>
                            <td><span class="badge bg-secondary">{{roleText role}}</span></td>
                            <td>{{class_name}}</td>
                            <td>{{department_name}}</td>
                            <td>
                                {{#if (eq id ../user.id)}}
                                    <span class="badge bg-info">Это вы</span>
                                {{else}}
                                    <form action="/admin/users/delete/{{id}}" method="POST" style="display:inline;" onsubmit="return confirm('Удалить пользователя {{full_name}}?')">
                                        <button type="submit" class="btn btn-sm btn-danger">🗑</button>
                                    </form>
                                {{/if}}
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="7" class="text-center text-muted">Нет пользователей</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <div class="mt-3 text-muted small">
            Всего пользователей: {{users.length}}
        </div>
    </div>
</div>
<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    👥 Управление пользователями
</h1>

<!-- Форма добавления пользователя -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
        <h5 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">
            ➕ Добавить пользователя
        </h5>
    </div>
    <div class="card-body">
        <form action="/admin/users/create" method="POST" class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" name="name" placeholder="ФИО" required>
            </div>
            <div class="col-md-2">
                <input type="text" class="form-control" name="pin" placeholder="PIN-код" required>
            </div>
            <div class="col-md-3">
                <select class="form-select" name="type" required>
                    <option value="1">Ученик</option>
                    <option value="2">Учитель</option>
                    <option value="3">Наставник</option>
                    <option value="4">Тьютор</option>
                    <option value="6">Родитель</option>
                    <option value="5">Администратор</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" name="kaf">
                    <option value="">Без класса/кафедры</option>
                    {{#each departments}}
                        <option value="{{id}}">{{name}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-plus-circle"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Список пользователей -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
        <span class="fw-semibold" style="color: var(--dark-gray, #172033);">Список пользователей</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ФИО</th>
                        <th>PIN</th>
                        <th>Роль</th>
                        <th>Класс/Кафедра</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each users}}
                        <tr>
                            <td>{{id}}</td>
                            <td>{{name}}</td>
                            <td>{{pin}}</td>
                            <td><span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.3rem 0.6rem;">{{roleName type}}</span></td>
                            <td>{{kaf_name}}</td>
                            <td>
                                {{#if (eq id ../user.id)}}
                                    <span class="badge bg-info" style="font-weight: 500; border-radius: 1rem; padding: 0.3rem 0.6rem;">Это вы</span>
                                {{else}}
                                    <form action="/admin/users/delete/{{id}}" method="POST" style="display:inline;" onsubmit="return confirm('Удалить пользователя {{name}}?')">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Удалить">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                {{/if}}
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">Нет пользователей</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        <div class="mt-3 text-muted small">
            Всего пользователей: {{users.length}}
        </div>
    </div>
</div>
<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    ⚙️ Настройки системы
</h1>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                <h5 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">
                    📚 Классы ({{classes.length}})
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    {{#each classes}}
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                            <span class="fw-semibold" style="color: var(--dark-gray, #172033);">{{name}}</span>
                            <span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.3rem 0.6rem;">ID: {{id}}</span>
                        </li>
                    {{else}}
                        <li class="list-group-item text-muted text-center py-3">Нет классов</li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                <h5 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">
                    🏛️ Кафедры ({{departments.length}})
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    {{#each departments}}
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                            <span style="color: var(--dark-gray, #172033);">{{name}}</span>
                            <span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.3rem 0.6rem;">ID: {{id}}</span>
                        </li>
                    {{else}}
                        <li class="list-group-item text-muted text-center py-3">Нет кафедр</li>
                    {{/each}}
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                <h5 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">
                    🏷️ Типы мероприятий ({{eventTypes.length}})
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    {{#each eventTypes}}
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-bottom">
                            <span style="color: var(--dark-gray, #172033);">{{name}}</span>
                            <span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.3rem 0.6rem;">ID: {{id}}</span>
                        </li>
                    {{else}}
                        <li class="list-group-item text-muted text-center py-3">Нет типов мероприятий</li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 text-muted small" style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
    <p>Данные загружены из базы данных. Для изменения используйте phpMyAdmin.</p>
</div>
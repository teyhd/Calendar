<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                <h4 class="text-center mb-0" style="color: var(--dark-gray, #172033); font-weight: 700;">
                    🔐 Вход в систему
                </h4>
                <p class="text-center text-muted small mt-1">Школьный календарь мероприятий</p>
            </div>
            <div class="card-body">
                {{#if error}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> {{error}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                    </div>
                {{/if}}

                <form action="/auth/login" method="POST">
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">
                            <i class="bi bi-envelope me-1"></i> Email
                        </label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="example@school.ru" required>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">
                            <i class="bi bi-lock me-1"></i> Пароль
                        </label>
                        <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Войти
                    </button>
                </form>

                {{#if (eq (lookup . "showTestUsers") true)}}
                    <hr class="my-4">
                    <div class="text-center">
                        <p class="text-muted small fw-semibold mb-2">🧪 Тестовые пользователи</p>
                        <div class="row g-1 small text-muted">
                            <div class="col-6">admin@school.ru</div>
                            <div class="col-6 text-primary fw-semibold">password123</div>
                            <div class="col-6">teacher@school.ru</div>
                            <div class="col-6 text-primary fw-semibold">password123</div>
                            <div class="col-6">student@school.ru</div>
                            <div class="col-6 text-primary fw-semibold">password123</div>
                            <div class="col-6">parent@school.ru</div>
                            <div class="col-6 text-primary fw-semibold">password123</div>
                        </div>
                    </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>
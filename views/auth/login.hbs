<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Вход в систему</h4>
            </div>
            <div class="card-body">
                {{#if error}}
                    <div class="alert alert-danger">{{error}}</div>
                {{/if}}
                
                <form action="/auth/login" method="POST">
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Пароль</label>
                        <input type="password" class="form-control" id="password" name="password" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Войти</button>
                </form>
                
                <hr>
                <div class="text-center text-muted small">
                    <p>Тестовые пользователи:</p>
                    <div class="row">
                        <div class="col-6">admin@school.ru</div>
                        <div class="col-6">password123</div>
                        <div class="col-6">teacher@school.ru</div>
                        <div class="col-6">password123</div>
                        <div class="col-6">student@school.ru</div>
                        <div class="col-6">password123</div>
                        <div class="col-6">parent@school.ru</div>
                        <div class="col-6">password123</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                <h4 class="text-center mb-0" style="color: var(--dark-gray, #172033); font-weight: 700;">
                    🔐 Вход в систему
                </h4>
                <p class="text-center text-muted small mt-1">Школьный календарь мероприятий</p>
            </div>
            <div class="card-body">
                {{#if error}}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> {{error}}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                    </div>
                {{/if}}

                <form action="/auth/login" method="POST">
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">
                            <i class="bi bi-person me-1"></i> Имя (ФИО)
                        </label>
                        <input type="text" class="form-control" id="name" name="name" placeholder="Иванов Иван Иванович" required>
                    </div>
                    <div class="mb-3">
                        <label for="pin" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">
                            <i class="bi bi-key me-1"></i> PIN-код
                        </label>
                        <input type="password" class="form-control" id="pin" name="pin" placeholder="••••" required>
                        <div class="form-text text-muted small">
                            Введите ваш PIN-код из системы «Гармония образования»
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Войти
                    </button>
                </form>

                <hr class="my-4">
                <div class="text-center text-muted small">
                    <p class="mb-1">Вход выполняется по имени и PIN-коду</p>
                    <p class="mb-0">Если вы не знаете свои данные, обратитесь к администратору.</p>
                </div>
            </div>
        </div>
    </div>
</div>
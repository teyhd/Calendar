<section class="app-page-head"><div><p class="app-page-kicker">Новое событие</p><h1 class="app-page-title">Создание мероприятия</h1><p class="app-page-summary">Заполните ключевые детали — форма проверит обязательные поля до отправки.</p></div></section>

<div class="app-form-layout">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form class="event-form" action="/events/create" method="POST" id="eventForm">
                    <!-- Основная информация -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Название *</label>
                        <input type="text" class="form-control" id="title" name="title" placeholder="Введите название мероприятия" maxlength="100" value="{{event.title}}" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Описание</label>
                        <textarea class="form-control" id="description" name="description" rows="3" placeholder="Краткое описание мероприятия" maxlength="500">{{event.description}}</textarea>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="event_type_id" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Тип мероприятия *</label>
                                <select class="form-select" id="event_type_id" name="event_type_id" required>
                                    <option value="">Выберите тип</option>
                                    {{#each types}}
                                        <option value="{{id}}" {{#if (eq ../event.event_type_id id)}}selected{{/if}}>{{name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="level" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Уровень</label>
                                <select class="form-select" id="level" name="level">
                                    <option value="school" {{#if (eq event.level "school")}}selected{{/if}}>Школьное</option>
                                    <option value="city" {{#if (eq event.level "city")}}selected{{/if}}>Городское</option>
                                    <option value="regional" {{#if (eq event.level "regional")}}selected{{/if}}>Региональное</option>
                                    <option value="national" {{#if (eq event.level "national")}}selected{{/if}}>Всероссийское</option>
                                    <option value="international" {{#if (eq event.level "international")}}selected{{/if}}>Международное</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="start_datetime" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Дата и время начала *</label>
                                <input type="datetime-local" class="form-control" id="start_datetime" name="start_datetime" value="{{formatDateForInput event.start_datetime}}" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="end_datetime" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Дата и время окончания *</label>
                                <input type="datetime-local" class="form-control" id="end_datetime" name="end_datetime" value="{{formatDateForInput event.end_datetime}}" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Место проведения</label>
                        <input type="text" class="form-control" id="location" name="location" placeholder="Например: Актовый зал, кабинет 301" value="{{event.location}}">
                    </div>
                    
                    <!-- Блок: Аудитория -->
                    <div class="block-outline mb-3">
                        <div class="card-header bg-transparent border-bottom-0 pt-2 pb-0 px-0">
                            <h6 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">Аудитория мероприятия</h6>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="target_audience_type" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Тип аудитории *</label>
                                        <select class="form-select" id="target_audience_type" name="target_audience_type" required>
                                            <option value="class" {{#if (eq event.target_audience_type "class")}}selected{{/if}}>Конкретный класс</option>
                                            <option value="multiple_classes" {{#if (eq event.target_audience_type "multiple_classes")}}selected{{/if}}>Несколько классов</option>
                                            <option value="parallel" {{#if (eq event.target_audience_type "parallel")}}selected{{/if}}>Целая параллель</option>
                                            <option value="department" {{#if (eq event.target_audience_type "department")}}selected{{/if}}>Кафедра</option>
                                            <option value="specific_users" {{#if (eq event.target_audience_type "specific_users")}}selected{{/if}}>Конкретные пользователи</option>
                                            <option value="all" {{#if (eq event.target_audience_type "all")}}selected{{/if}}>Все пользователи</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6" id="audience_target_container">
                                    <!-- Выпадающий список для class, parallel, department -->
                                    <div id="select_audience_container">
                                        <label for="target_audience_id" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Выберите аудиторию</label>
                                        <select class="form-select" id="target_audience_id" name="target_audience_id">
                                            <option value="">Сначала выберите тип аудитории</option>
                                        </select>
                                    </div>
                                    <!-- Блок: Конкретные пользователи (поиск + чипсы) -->
                                    <div id="specific_users_block" style="{{#if (eq event.target_audience_type "specific_users")}}display:block;{{else}}display:none;{{/if}}">
                                        <label class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Выберите пользователей</label>
                                        <div class="row g-2">
                                            <div class="col-12" style="position: relative;">
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="userSearchInput" placeholder="Начните вводить имя пользователя..." autocomplete="off">
                                                    <button class="btn btn-outline-secondary" type="button" id="clearSearchBtn">✕</button>
                                                </div>
                                                <div id="searchResults" class="list-group mt-1" style="display: none; max-height: 200px; overflow-y: auto; position: absolute; z-index: 1000; left: 0; width: 100%; max-width: 350px;"></div>
                                            </div>
                                            <div class="col-12">
                                                <div id="selectedUsersContainer" class="d-flex flex-wrap gap-2 mt-2">
                                                    <!-- Здесь будут чипсы выбранных пользователей -->
                                                </div>
                                                <!-- Скрытое поле для хранения ID выбранных пользователей -->
                                                <input type="hidden" id="selectedUsersIds" name="target_audience_ids" value="">
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Блок: Несколько классов (поиск + чипсы) -->
                                    <div id="multiple_classes_block" style="{{#if (eq event.target_audience_type "multiple_classes")}}display:block;{{else}}display:none;{{/if}}">
                                        <label class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Выберите классы</label>
                                        <div class="row g-2">
                                            <div class="col-12" style="position: relative;">
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="classSearchInput" placeholder="Начните вводить название класса..." autocomplete="off">
                                                    <button class="btn btn-outline-secondary" type="button" id="clearClassSearchBtn">✕</button>
                                                </div>
                                                <div id="classSearchResults" class="list-group mt-1" style="display: none; max-height: 200px; overflow-y: auto; position: absolute; z-index: 1000; left: 0; width: 100%; max-width: 350px;"></div>
                                            </div>
                                            <div class="col-12">
                                                <div id="selectedClassesContainer" class="d-flex flex-wrap gap-2 mt-2">
                                                    <!-- Чипсы выбранных классов -->
                                                </div>
                                                <input type="hidden" id="selectedClassesIds" name="target_audience_ids" value="">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Блок: Ответственные -->
                    <div class="block-outline mb-3">
                        <div class="card-header bg-transparent border-bottom-0 pt-2 pb-0 px-0">
                            <h6 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">
                                Ответственные за мероприятие
                            </h6>
                            <p class="text-muted small mt-1">Укажите одного или нескольких ответственных организаторов</p>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="row g-2">
                                <div class="col-12" style="position: relative;">
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="responsibleSearchInput" 
                                               placeholder="Начните вводить имя ответственного..." autocomplete="off">
                                        <button class="btn btn-outline-secondary" type="button" id="clearResponsibleSearchBtn">✕</button>
                                    </div>
                                    <div id="responsibleSearchResults" class="list-group mt-1" 
                                         style="display: none; max-height: 200px; overflow-y: auto; position: absolute; z-index: 1000; left: 0; width: 100%; max-width: 350px;">
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div id="selectedResponsibleContainer" class="d-flex flex-wrap gap-2 mt-2">
                                        <!-- Чипсы выбранных ответственных -->
                                    </div>
                                    <input type="hidden" id="selectedResponsibleIds" name="responsible_ids" value="">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Блок: Награды (визуал) -->
                    <div class="block-outline border-warning mb-3">
                        <div class="card-header bg-transparent border-bottom-0 pt-2 pb-0 px-0">
                            <h6 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">Награды за участие (опционально)</h6>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="form-check mb-3">
                                {{#if event}}
                                    <input class="form-check-input form-check-input-lg" type="checkbox" id="enable_rewards" name="enable_rewards" value="1" {{#if (ne event.reward_type "none")}}checked{{/if}}>
                                {{else}}
                                    <input class="form-check-input form-check-input-lg" type="checkbox" id="enable_rewards" name="enable_rewards" value="1">
                                {{/if}}
                                <label class="form-check-label form-check-label-lg" for="enable_rewards">
                                    Начислять очки за участие
                                </label>
                            </div>
        
                            <div id="rewards_block" style="display: none;">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label for="reward_type" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Тип события</label>
                                            <select class="form-select" id="reward_type" name="reward_type">
                                                <option value="educational" {{#if (eq event.reward_type "educational")}}selected{{/if}}>Учебное (всем участникам очки)</option>
                                                <option value="competitive" {{#if (eq event.reward_type "competitive")}}selected{{/if}}>Соревновательное (распределение мест)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6" id="places_block">
                                        <div class="mb-3">
                                            <label for="places_count" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Количество призовых мест</label>
                                            <input type="number" class="form-control" id="places_count" name="places_count" min="1" max="100" value="{{event.reward_places}}" step="1">
                                            <div class="form-text text-muted small">Введите число от 1 до 100</div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="alert alert-info border-0 small">
                                    <p class="mb-0">
                                        <strong>Как будут начисляться очки:</strong><br>
                                        <span id="reward_description">Учебное: все участники получат по 10 очков</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Блок: Запись на мероприятие -->
                    <div class="block-outline mb-3">
                        <div class="card-header bg-transparent border-bottom-0 pt-2 pb-0 px-0">
                            <h6 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">Запись на мероприятие</h6>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="form-check mb-3">
                                <input class="form-check-input form-check-input-lg" type="checkbox" id="is_registration_enabled" name="is_registration_enabled" value="1" {{#if event.is_registration_enabled}}checked{{/if}}>
                                <label class="form-check-label form-check-label-lg" for="is_registration_enabled">
                                    Участники могут записываться на это мероприятие
                                </label>
                                <div class="form-text text-muted small">
                                    Если включено, ученики и родители смогут нажать "Записаться" и отметиться о своём участии.
                                    Это полезно для мероприятий, где посещение необязательно и нужна аналитика.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Для администратора (показывается только педагогам и админам) -->
                    {{#if (or (eq user.type 2) (or (eq user.type 3) (or (eq user.type 4) (eq user.type 5))))}}
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="is_admin_event" name="is_admin_event" value="1" {{#if event.is_admin_event}}checked{{/if}}>
                            <label class="form-check-label" for="is_admin_event">
                            Только для администраторов (не видно ученикам и родителям)
                            </label>
                        </div>
                    {{/if}}
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            {{#if isCopy}}Создать исправленную заявку{{else}}Создать мероприятие{{/if}}
                        </button>
                        <a href="/" class="btn btn-secondary px-4 fw-semibold">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Подсказка справа -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 sticky-top" style="top: 1rem;">
            <div class="card-header bg-transparent border-bottom-0 pt-3">
                <h5 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">Подсказка</h5>
            </div>
            <div class="card-body">
                <p><strong>Кто увидит мероприятие?</strong></p>
                <ul class="small">
                    <li><strong>Класс</strong> — выберите конкретный класс (например, 5А)</li>
                    <li><strong>Параллель</strong> — выберите номер параллели (например, 5 класс)</li>
                    <li><strong>Кафедра</strong> — выберите кафедру (например, Математика)</li>
                    <li><strong>Пользователи</strong> — выберите конкретного пользователя</li>
                    <li><strong>Все</strong> — увидят все пользователи системы</li>
                </ul>
                <hr>
                <p><strong>Награды:</strong></p>
                <ul class="small">
                    <li>Включите, если хотите начислить очки участникам</li>
                    <li>Для учебных мероприятий — очки получают все</li>
                    <li>Для соревновательных — можно распределить места</li>
                </ul>
                <hr>
                <p class="text-muted small">* — обязательные поля</p>
                <div class="alert alert-warning border-0 small">
                    После создания мероприятие отправляется на модерацию администратору.
                </div>
            </div>
        </div>
    </div>
</div>
<div id="data-container" 
     data-classes='{{{json classes}}}' 
     data-departments='{{{json departments}}}' 
     data-users='{{{json users}}}'>
</div>


<script>
document.addEventListener('DOMContentLoaded', function() {
    // ---------- Получение данных из data-атрибутов ----------
    const container = document.getElementById('data-container');
    const allClasses = JSON.parse(container.dataset.classes) || [];
    const departments = JSON.parse(container.dataset.departments) || [];
    const allUsers = JSON.parse(container.dataset.users) || [];


    // Переменные для предзаполнения чипсов (при копировании)
    const initialSelectedIds = {{{json selectedIds}}} || [];
    const initialClassIds = {{{json selectedClassIds}}} || [];
    const initialResponsibleIds = {{{json selectedResponsibleIds}}} || [];

    // ---------- Элементы DOM ----------
    const typeSelect = document.getElementById('target_audience_type');
    const selectContainer = document.getElementById('select_audience_container');
    const targetSelect = document.getElementById('target_audience_id');
    const specificUsersBlock = document.getElementById('specific_users_block');
    const multipleClassesBlock = document.getElementById('multiple_classes_block');

    // ========== ЧИПСЫ ДЛЯ КЛАССОВ ==========
    const classSearchInput = document.getElementById('classSearchInput');
    const classResults = document.getElementById('classSearchResults');
    const selectedClassesContainer = document.getElementById('selectedClassesContainer');
    const selectedClassesHidden = document.getElementById('selectedClassesIds');

    let selectedClasses = [];

    // ---- Предзаполнение классов при копировании ----
    if (initialClassIds.length > 0) {
        initialClassIds.forEach(id => {
            const cls = allClasses.find(c => c.id === id);
            if (cls) selectedClasses.push(cls);
        });
    }

    function searchClasses(query) {
        if (!query.trim()) return [];
        const q = query.toLowerCase().trim();
        return allClasses.filter(c => c.name.toLowerCase().includes(q));
    }

    function renderClassResults(results) {
        classResults.innerHTML = '';
        if (results.length === 0) {
            classResults.style.display = 'none';
            return;
        }
        results.forEach(cls => {
            const item = document.createElement('a');
            item.href = '#';
            item.className = 'list-group-item list-group-item-action';
            item.textContent = cls.name;
            item.dataset.id = cls.id;
            item.addEventListener('click', function(e) {
                e.preventDefault();
                addClass(cls);
                classSearchInput.value = '';
                classResults.style.display = 'none';
            });
            classResults.appendChild(item);
        });
        classResults.style.display = 'block';
    }

    function addClass(cls) {
        if (selectedClasses.some(c => c.id === cls.id)) return;
        selectedClasses.push(cls);
        renderClassChips();
        classSearchInput.value = '';
        classResults.style.display = 'none';
        updateClassHiddenInput();
    }

    function removeClass(clsId) {
        selectedClasses = selectedClasses.filter(c => c.id !== clsId);
        renderClassChips();
        updateClassHiddenInput();
    }

    function renderClassChips() {
        selectedClassesContainer.innerHTML = '';
        selectedClasses.forEach(cls => {
            const chip = document.createElement('span');
            chip.className = 'badge bg-success d-inline-flex align-items-center gap-1 p-2';
            chip.style.fontSize = '0.9rem';
            chip.innerHTML = `
                ${cls.name}
                <span role="button" class="ms-1" style="cursor:pointer;" data-classid="${cls.id}">&times;</span>
            `;
            chip.querySelector('span[data-classid]').addEventListener('click', function() {
                removeClass(parseInt(this.dataset.classid));
            });
            selectedClassesContainer.appendChild(chip);
        });
    }

    function updateClassHiddenInput() {
        const ids = selectedClasses.map(c => c.id);
        selectedClassesHidden.value = ids.join(',');
        console.log('Классы сохранены:', selectedClassesHidden.value);
    }

    // Поиск классов
    let classTimeout = null;
    classSearchInput.addEventListener('input', function() {
        clearTimeout(classTimeout);
        classTimeout = setTimeout(() => {
            const results = searchClasses(this.value);
            renderClassResults(results);
        }, 200);
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#classSearchInput') && !e.target.closest('#classSearchResults')) {
            classResults.style.display = 'none';
        }
    });
    document.getElementById('clearClassSearchBtn').addEventListener('click', function() {
        classSearchInput.value = '';
        classResults.style.display = 'none';
        classSearchInput.focus();
    });
    classSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            const results = searchClasses(this.value);
            if (results.length > 0) {
                addClass(results[0]);
                this.value = '';
                classResults.style.display = 'none';
            }
        }
    });

    // ---- Если есть предзаполненные классы, рендерим чипсы ----
    if (selectedClasses.length > 0) {
        renderClassChips();
        updateClassHiddenInput();
    }

    // ========== ЧИПСЫ ДЛЯ ПОЛЬЗОВАТЕЛЕЙ (аудитория) ==========
    const userSearchInput = document.getElementById('userSearchInput');
    const userResults = document.getElementById('searchResults');
    const selectedUsersContainer = document.getElementById('selectedUsersContainer');
    const selectedUsersHidden = document.getElementById('selectedUsersIds');
    let selectedUsers = [];

    // ---- Предзаполнение пользователей при копировании ----
    if (initialSelectedIds.length > 0) {
        initialSelectedIds.forEach(id => {
            const user = allUsers.find(u => u.id === id);
            if (user) selectedUsers.push(user);
        });
    }

    function searchUsers(query) {
        if (!query.trim()) return [];
        const q = query.toLowerCase().trim();
        return allUsers.filter(u => u.name.toLowerCase().includes(q));
    }

    function renderUserResults(results) {
        userResults.innerHTML = '';
        if (results.length === 0) {
            userResults.style.display = 'none';
            return;
        }
        results.forEach(user => {
            const item = document.createElement('a');
            item.href = '#';
            item.className = 'list-group-item list-group-item-action';
            item.textContent = `${user.name} (${roleText(user.type)})`;
            item.dataset.id = user.id;
            item.addEventListener('click', function(e) {
                e.preventDefault();
                addUser(user);
                userSearchInput.value = '';
                userResults.style.display = 'none';
            });
            userResults.appendChild(item);
        });
        userResults.style.display = 'block';
    }

    function addUser(user) {
        if (selectedUsers.some(u => u.id === user.id)) return;
        selectedUsers.push(user);
        renderUserChips();
        userSearchInput.value = '';
        userResults.style.display = 'none';
        updateUserHiddenInput();
    }

    function removeUser(userId) {
        selectedUsers = selectedUsers.filter(u => u.id !== userId);
        renderUserChips();
        updateUserHiddenInput();
    }

    function renderUserChips() {
        selectedUsersContainer.innerHTML = '';
        selectedUsers.forEach(user => {
            const chip = document.createElement('span');
            chip.className = 'badge bg-primary d-inline-flex align-items-center gap-1 p-2';
            chip.style.fontSize = '0.9rem';
            chip.innerHTML = `
                ${user.name}
                <span role="button" class="ms-1" style="cursor:pointer;" data-userid="${user.id}">&times;</span>
            `;
            chip.querySelector('span[data-userid]').addEventListener('click', function() {
                removeUser(parseInt(this.dataset.userid));
            });
            selectedUsersContainer.appendChild(chip);
        });
    }

    function updateUserHiddenInput() {
        const ids = selectedUsers.map(u => u.id);
        selectedUsersHidden.value = ids.join(',');
        console.log('Пользователи сохранены:', selectedUsersHidden.value);
    }

    function roleText(type) {
        const roles = {1: 'Ученик', 2: 'Учитель', 3: 'Наставник', 4: 'Тьютор', 5: 'Админ', 6: 'Родитель'};
        return roles[type] || 'Неизвестно';
    }

    // Поиск пользователей
    let userTimeout = null;
    userSearchInput.addEventListener('input', function() {
        clearTimeout(userTimeout);
        userTimeout = setTimeout(() => {
            const results = searchUsers(this.value);
            renderUserResults(results);
        }, 200);
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#userSearchInput') && !e.target.closest('#searchResults')) {
            userResults.style.display = 'none';
        }
    });
    document.getElementById('clearSearchBtn').addEventListener('click', function() {
        userSearchInput.value = '';
        userResults.style.display = 'none';
        userSearchInput.focus();
    });
    userSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            const results = searchUsers(this.value);
            if (results.length > 0) {
                addUser(results[0]);
                this.value = '';
                userResults.style.display = 'none';
            }
        }
    });

    // ---- Если есть предзаполненные пользователи, рендерим чипсы ----
    if (selectedUsers.length > 0) {
        renderUserChips();
        updateUserHiddenInput();
    }

    // ========== ЧИПСЫ ДЛЯ ОТВЕТСТВЕННЫХ ==========
    const responsibleSearchInput = document.getElementById('responsibleSearchInput');
    const responsibleResults = document.getElementById('responsibleSearchResults');
    const selectedResponsibleContainer = document.getElementById('selectedResponsibleContainer');
    const selectedResponsibleHidden = document.getElementById('selectedResponsibleIds');

    let selectedResponsible = [];

    // ---- Предзаполнение ответственных при копировании ----
    if (initialResponsibleIds.length > 0) {
        initialResponsibleIds.forEach(id => {
            const user = allUsers.find(u => u.id === id);
            if (user && [2,3,4,5].includes(user.type)) {
                selectedResponsible.push(user);
            }
        });
    }

    function searchResponsible(query) {
        if (!query.trim()) return [];
        const q = query.toLowerCase().trim();
        // Только педагоги и админы (type 2,3,4,5)
        return allUsers.filter(u => 
            u.name.toLowerCase().includes(q) && 
            [2, 3, 4, 5].includes(u.type)
        );
    }

    function renderResponsibleResults(results) {
        responsibleResults.innerHTML = '';
        if (results.length === 0) {
            responsibleResults.style.display = 'none';
            return;
        }
        results.forEach(user => {
            const item = document.createElement('a');
            item.href = '#';
            item.className = 'list-group-item list-group-item-action';
            item.textContent = `${user.name} (${roleText(user.type)})`;
            item.dataset.id = user.id;
            item.addEventListener('click', function(e) {
                e.preventDefault();
                addResponsible(user);
                responsibleSearchInput.value = '';
                responsibleResults.style.display = 'none';
            });
            responsibleResults.appendChild(item);
        });
        responsibleResults.style.display = 'block';
    }

    function addResponsible(user) {
        if (selectedResponsible.some(u => u.id === user.id)) return;
        selectedResponsible.push(user);
        renderResponsibleChips();
        responsibleSearchInput.value = '';
        responsibleResults.style.display = 'none';
        updateResponsibleHiddenInput();
    }

    function removeResponsible(userId) {
        selectedResponsible = selectedResponsible.filter(u => u.id !== userId);
        renderResponsibleChips();
        updateResponsibleHiddenInput();
    }

    function renderResponsibleChips() {
        selectedResponsibleContainer.innerHTML = '';
        selectedResponsible.forEach(user => {
            const chip = document.createElement('span');
            chip.className = 'badge bg-warning d-inline-flex align-items-center gap-1 p-2';
            chip.style.fontSize = '0.9rem';
            chip.style.color = '#212529';
            chip.innerHTML = `
                ${user.name}
                <span role="button" class="ms-1" style="cursor:pointer; color: #212529;" data-responsibleid="${user.id}">&times;</span>
            `;
            chip.querySelector('span[data-responsibleid]').addEventListener('click', function() {
                removeResponsible(parseInt(this.dataset.responsibleid));
            });
            selectedResponsibleContainer.appendChild(chip);
        });
    }

    function updateResponsibleHiddenInput() {
        const ids = selectedResponsible.map(u => u.id);
        selectedResponsibleHidden.value = ids.join(',');
        console.log('Ответственные сохранены:', selectedResponsibleHidden.value);
    }

    // Поиск ответственных
    let responsibleTimeout = null;
    responsibleSearchInput.addEventListener('input', function() {
        clearTimeout(responsibleTimeout);
        responsibleTimeout = setTimeout(() => {
            const results = searchResponsible(this.value);
            renderResponsibleResults(results);
        }, 200);
    });
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#responsibleSearchInput') && !e.target.closest('#responsibleSearchResults')) {
            responsibleResults.style.display = 'none';
        }
    });
    document.getElementById('clearResponsibleSearchBtn').addEventListener('click', function() {
        responsibleSearchInput.value = '';
        responsibleResults.style.display = 'none';
        responsibleSearchInput.focus();
    });
    responsibleSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            const results = searchResponsible(this.value);
            if (results.length > 0) {
                addResponsible(results[0]);
                this.value = '';
                responsibleResults.style.display = 'none';
            }
        }
    });

    // ---- Если есть предзаполненные ответственные, рендерим чипсы ----
    if (selectedResponsible.length > 0) {
        renderResponsibleChips();
        updateResponsibleHiddenInput();
    }

    // ========== УПРАВЛЕНИЕ ВИДИМОСТЬЮ (аудитория) ==========
    function updateAudienceControls() {
        const type = typeSelect.value;
        selectContainer.style.display = 'none';
        specificUsersBlock.style.display = 'none';
        multipleClassesBlock.style.display = 'none';

        if (type === 'specific_users') {
            specificUsersBlock.style.display = 'block';
        } else if (type === 'multiple_classes') {
            multipleClassesBlock.style.display = 'block';
        } else {
            selectContainer.style.display = 'block';
            targetSelect.innerHTML = '<option value="">Выберите...</option>';
            if (!type) {
                targetSelect.innerHTML = '<option value="">Сначала выберите тип аудитории</option>';
                return;
            }
            let options = [];
            if (type === 'class') {
                if (!allClasses || allClasses.length === 0) {
                    targetSelect.innerHTML = '<option value="">Нет доступных классов</option>';
                    return;
                }
                options = allClasses.map(c => ({value: c.id, text: c.name}));
            } else if (type === 'parallel') {
                if (!allClasses || allClasses.length === 0) {
                    targetSelect.innerHTML = '<option value="">Нет данных для параллелей</option>';
                    return;
                }
                const parallels = [...new Set(allClasses.map(c => c.name.replace(/-.*$/, '')))].sort();
                options = parallels.map(p => ({value: p, text: `${p} класс`}));
            } else if (type === 'department') {
                if (!departments || departments.length === 0) {
                    targetSelect.innerHTML = '<option value="">Нет доступных кафедр</option>';
                    return;
                }
                options = departments.map(d => ({value: d.id, text: d.name}));
            } else if (type === 'all') {
                targetSelect.innerHTML = '<option value="">Все пользователи системы</option>';
                return;
            }
            options.forEach(opt => {
                const option = document.createElement('option');
                option.value = opt.value;
                option.textContent = opt.text;
                targetSelect.appendChild(option);
            });
        }
    }

// Принудительно устанавливаем тип аудитории (если не выбран или пустой)
if (!typeSelect.value || typeSelect.value === '') {
    typeSelect.value = 'class';
}

// Добавляем обработчик и сразу вызываем
typeSelect.addEventListener('change', updateAudienceControls);
updateAudienceControls();

// Дополнительная проверка: если список всё равно пуст, выводим в консоль
console.log('Текущий тип аудитории:', typeSelect.value);
console.log('Количество классов для заполнения:', allClasses.length);

    typeSelect.addEventListener('change', updateAudienceControls);
    updateAudienceControls();

    // ---------- НАГРАДЫ (логика показа) ----------
    const enableCheckbox = document.getElementById('enable_rewards');
    const rewardsBlock = document.getElementById('rewards_block');
    const rewardTypeSelect = document.getElementById('reward_type');
    const placesBlock = document.getElementById('places_block');
    const rewardDescription = document.getElementById('reward_description');

    function updateRewardsUI() {
        if (enableCheckbox.checked) {
            rewardsBlock.style.display = 'block';
            updateRewardDescription();
        } else {
            rewardsBlock.style.display = 'none';
        }
    }

    function updateRewardDescription() {
        const type = rewardTypeSelect.value;
        const places = document.getElementById('places_count').value;
        if (type === 'educational') {
            rewardDescription.textContent = 'Учебное: все участники получат по 10 очков';
            placesBlock.style.display = 'none';
        } else {
            rewardDescription.textContent = `Соревновательное: участники распределят ${places} призовых мест (1 место — 50 очков, 2 место — 30 очков, 3 место — 20 очков, участники — 10 очков)`;
            placesBlock.style.display = 'block';
        }
    }

    enableCheckbox.addEventListener('change', updateRewardsUI);
    rewardTypeSelect.addEventListener('change', updateRewardDescription);
    document.getElementById('places_count').addEventListener('change', updateRewardDescription);

    updateRewardsUI();
    updateRewardDescription();

    // ===== ВАЛИДАЦИЯ ФОРМЫ =====
    const form = document.getElementById('eventForm');

    // 1. Обрезка полей при вводе и вставке
    const titleInput = document.getElementById('title');
    const descInput = document.getElementById('description');

    function trimField(input, maxLength, fieldName) {
        if (!input) return;
        input.addEventListener('input', function() {
            if (this.value.length > maxLength) {
                this.value = this.value.slice(0, maxLength);
            }
        });
        input.addEventListener('paste', function(e) {
            setTimeout(() => {
                if (this.value.length > maxLength) {
                    this.value = this.value.slice(0, maxLength);
                }
            }, 0);
        });
        input.addEventListener('drop', function(e) {
            setTimeout(() => {
                if (this.value.length > maxLength) {
                    this.value = this.value.slice(0, maxLength);
                }
            }, 0);
        });
    }

    trimField(titleInput, 100, 'Название');
    trimField(descInput, 500, 'Описание');

    // 2. Функция для отображения ошибки под полем
    function showError(field, message) {
        const existingError = field.parentNode.querySelector('.invalid-feedback');
        if (existingError) {
            existingError.remove();
        }
        field.classList.add('is-invalid');
        const errorElement = document.createElement('div');
        errorElement.className = 'invalid-feedback';
        errorElement.textContent = message;
        field.parentNode.appendChild(errorElement);
        field.focus();
    }

    // 3. Функция для очистки ошибок
    function clearErrors() {
        document.querySelectorAll('.is-invalid').forEach(el => {
            el.classList.remove('is-invalid');
        });
        document.querySelectorAll('.invalid-feedback').forEach(el => {
            el.remove();
        });
    }

    // 4. Валидация при отправке
    if (form) {
        form.addEventListener('submit', function(e) {
            clearErrors();
            let hasError = false;

            // ---- Проверка названия ----
            if (titleInput) {
                const title = titleInput.value.trim();
                if (title === '') {
                    showError(titleInput, 'Пожалуйста, введите название мероприятия');
                    hasError = true;
                } else if (title.length > 100) {
                    showError(titleInput, 'Название не должно превышать 100 символов');
                    hasError = true;
                }
            }

            // ---- Проверка описания ----
            if (descInput) {
                const desc = descInput.value;
                if (desc.length > 500) {
                    showError(descInput, 'Описание не должно превышать 500 символов');
                    hasError = true;
                }
            }

            // ---- Проверка дат ----
            const startInput = document.getElementById('start_datetime');
            const endInput = document.getElementById('end_datetime');

            if (startInput && endInput) {
                const startVal = startInput.value;
                const endVal = endInput.value;

                if (!startVal) {
                    showError(startInput, 'Пожалуйста, укажите дату и время начала');
                    hasError = true;
                } else if (!endVal) {
                    showError(endInput, 'Пожалуйста, укажите дату и время окончания');
                    hasError = true;
                } else {
                    const startDate = new Date(startVal);
                    const endDate = new Date(endVal);
                    const now = new Date();

                    if (startDate >= endDate) {
                        showError(startInput, 'Дата начала должна быть раньше даты окончания');
                        hasError = true;
                    } else if (startDate < now) {
                        showError(startInput, 'Дата начала не может быть в прошлом');
                        hasError = true;
                    }
                }
            }

            // ---- Проверка аудитории ----
            const audienceType = document.getElementById('target_audience_type').value;
            const audienceSelect = document.getElementById('target_audience_id');

            if (audienceType === 'class' || audienceType === 'parallel' || audienceType === 'department') {
                if (!audienceSelect || !audienceSelect.value) {
                    showError(audienceSelect, 'Пожалуйста, выберите аудиторию для мероприятия');
                    hasError = true;
                }
            }

            if (audienceType === 'specific_users') {
                const selectedIds = document.getElementById('selectedUsersIds');
                if (!selectedIds || !selectedIds.value || selectedIds.value.split(',').filter(id => id).length === 0) {
                    const container = document.getElementById('selectedUsersContainer');
                    if (container) {
                        const existingError = container.parentNode.querySelector('.invalid-feedback');
                        if (existingError) existingError.remove();
                        const errorElement = document.createElement('div');
                        errorElement.className = 'invalid-feedback d-block';
                        errorElement.textContent = 'Пожалуйста, выберите хотя бы одного пользователя';
                        container.parentNode.appendChild(errorElement);
                        hasError = true;
                    }
                }
            }

            if (audienceType === 'multiple_classes') {
                const selectedClasses = document.getElementById('selectedClassesIds');
                if (!selectedClasses || !selectedClasses.value || selectedClasses.value.split(',').filter(id => id).length === 0) {
                    const container = document.getElementById('selectedClassesContainer');
                    if (container) {
                        const existingError = container.parentNode.querySelector('.invalid-feedback');
                        if (existingError) existingError.remove();
                        const errorElement = document.createElement('div');
                        errorElement.className = 'invalid-feedback d-block';
                        errorElement.textContent = 'Пожалуйста, выберите хотя бы один класс';
                        container.parentNode.appendChild(errorElement);
                        hasError = true;
                    }
                }
            }

            // ---- Проверка ответственных (обязательное поле) ----
            const responsibleIds = document.getElementById('selectedResponsibleIds');
            if (!responsibleIds || !responsibleIds.value || responsibleIds.value.split(',').filter(id => id).length === 0) {
                const container = document.getElementById('selectedResponsibleContainer');
                if (container) {
                    const existingError = container.parentNode.querySelector('.invalid-feedback');
                    if (existingError) existingError.remove();
                    const errorElement = document.createElement('div');
                    errorElement.className = 'invalid-feedback d-block';
                    errorElement.textContent = 'Пожалуйста, выберите хотя бы одного ответственного';
                    container.parentNode.appendChild(errorElement);
                    hasError = true;
                }
            }

            // Если есть ошибки — отменяем отправку
            if (hasError) {
                e.preventDefault();
            }
        });
    }
});
</script>

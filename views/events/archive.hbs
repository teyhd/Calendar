<section class="app-page-head"><div><p class="app-page-kicker">История</p><h1 class="app-page-title">Архив мероприятий</h1><p class="app-page-summary">Завершённые, отменённые и отклонённые события.</p></div><a class="app-btn app-btn-secondary" href="/">К календарю</a></section>

{{#if events.length}}
<section class="app-event-list" aria-label="Архив мероприятий">
    {{#each events}}
    <article class="app-event-row" data-event-id="{{id}}">
        <div><span class="app-event-title">{{title}}</span><span class="app-event-description">{{description}}</span></div>
        <div><span class="app-status app-status-{{#if (eq status "REJECTED")}}rejected{{else if (eq status "CANCELED")}}canceled{{else if (eq status "COMPLETED")}}completed{{else}}draft{{/if}}">{{statusText status}}</span><span class="app-type">{{type_name}}</span></div>
        <div class="app-event-meta"><span>{{formatDate start_datetime}} — {{formatDate end_datetime}}</span>{{#if location}}<span>{{location}}</span>{{/if}}{{#if review_text}}<span>Есть отзыв</span>{{/if}}</div>
        <div class="app-actions-row">
            {{#if (eq status "REJECTED")}}{{#if (or (eq created_by ../user.id) ../user.permissions.moderate_event)}}<a class="app-btn app-btn-warning app-btn-sm" href="/events/copy/{{id}}">Повторить</a>{{/if}}
            {{else if (eq status "COMPLETED")}}{{#if (or (eq created_by ../user.id) ../user.permissions.moderate_event)}}<button class="app-btn app-btn-secondary app-btn-sm" type="button" data-review-trigger data-review-event-id="{{id}}" data-review-text="{{review_text}}">{{#if review_text}}Изменить отзыв{{else}}Добавить отзыв{{/if}}</button>{{/if}}{{/if}}
        </div>
    </article>
    {{/each}}
</section>
{{else}}
<section class="app-surface app-empty"><h2>Архив пуст</h2><p>Завершённые и отменённые мероприятия появятся здесь.</p><a class="app-btn app-btn-secondary" href="/">Вернуться к календарю</a></section>
{{/if}}

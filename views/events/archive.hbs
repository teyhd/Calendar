<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    📦 Архив мероприятий
</h1>

{{#if events.length}}
    <div class="row g-4">
        {{#each events}}
            <div class="col-md-6 col-lg-4">
                <div class="card card-outline h-100" 
                     data-event-id="{{id}}" 
                     style="cursor: pointer;"
                     onmouseover="this.style.transform='translateY(-3px)'"
                     onmouseout="this.style.transform=''">
                    <div class="card-header bg-transparent border-bottom-0 d-flex justify-content-between align-items-center pt-3 pb-0">
                        <span class="badge" style="background-color: {{statusColor status}}; color: #fff; font-weight: 500; border-radius: 1rem; padding: 0.4rem 0.75rem;">
                            {{statusText status}}
                        </span>
                        <span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.4rem 0.75rem;">
                            {{type_name}}
                        </span>
                    </div>
                    <div class="card-body position-relative">
                        <i class="bi bi-hand-index-thumb float-end text-muted opacity-50" style="font-size: 1.2rem;"></i>
                        <h5 class="card-title fw-semibold" style="color: var(--dark-gray, #172033);">{{title}}</h5>
                        <p class="card-text small text-muted">{{description}}</p>
                        <div class="small text-muted">
                            <div>📅 {{formatDate start_datetime}} — {{formatDate end_datetime}}</div>
                            <div>📍 {{location}}</div>
                            <div>👤 {{creator_name}}</div>
                            {{#if (isTeacherRole ../userType)}}
                                <div>👥 Участников: {{participants_count}}</div>
                            {{/if}}
                            {{#ifEquals ../userType 1}}
                                <div>📝 {{participation_status}}</div>
                            {{/ifEquals}}
                            {{#if cancel_reason}}
                                <div><strong>Причина:</strong> {{cancel_reason}}</div>
                            {{/if}}
                            {{#if review_text}}
                                <div class="mt-2 p-2 bg-light rounded small" style="border-left: 3px solid #0d6efd;">
                                    <strong>📋 Отзыв:</strong><br>
                                    <span class="text-muted">{{review_text}}</span>
                                    {{#if reviewer_name}}
                                        <div class="text-muted" style="font-size: 0.7rem; margin-top: 0.2rem;">
                                            Автор: {{reviewer_name}} ({{formatDate review_created_at}})
                                        </div>
                                    {{/if}}
                                </div>
                            {{/if}}
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0">
                        {{#if (eq status "REJECTED")}}
                            {{#if (or (eq created_by ../user.id) (or (eq ../userType 5) (eq ../userType 7)))}}
                                <a href="/events/copy/{{id}}" class="btn btn-warning btn-sm w-100 fw-semibold" onclick="event.stopPropagation();">
                                    🔄 Повторить (исправить)
                                </a>
                            {{else}}
                                <div class="text-center text-muted small" style="font-size: 0.75rem; opacity: 0.7;">
                                    <i class="bi bi-chevron-down"></i>
                                </div>
                            {{/if}}
                        {{else if (eq status "COMPLETED")}}
                            {{#if (or (eq created_by ../user.id) (or (eq ../userType 5) (eq ../userType 7)))}}
                                <div class="d-flex gap-2">
                                    {{#if review_text}}
                                        <button class="btn btn-info btn-sm w-100 fw-semibold" onclick="event.stopPropagation(); openReviewModal({{id}}, '{{review_text}}')">
                                            📝 Редактировать отзыв
                                        </button>
                                    {{else}}
                                        <button class="btn btn-info btn-sm w-100 fw-semibold" onclick="event.stopPropagation(); openReviewModal({{id}}, '')">
                                            📝 Добавить отзыв
                                        </button>
                                    {{/if}}
                                </div>
                            {{else}}
                                <div class="text-center text-muted small" style="font-size: 0.75rem; opacity: 0.7;">
                                    <i class="bi bi-chevron-down"></i>
                                </div>
                            {{/if}}
                        {{else}}
                            <div class="text-center text-muted small" style="font-size: 0.75rem; opacity: 0.7;">
                                <i class="bi bi-chevron-down"></i>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
    <div class="mt-4">
        <a href="/" class="btn btn-primary">← Вернуться к календарю</a>
    </div>
{{else}}
    <div class="alert alert-info border-0 shadow-sm" style="border-radius: 0.75rem;">
        <p class="mb-0">В архиве пока нет мероприятий.</p>
    </div>
    <div class="mt-3">
        <a href="/" class="btn btn-primary">← Вернуться к календарю</a>
    </div>
{{/if}}
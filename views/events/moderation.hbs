<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    🔍 Модерация мероприятий
</h1>

{{#if events.length}}
    <div class="row g-4">
        {{#each events}}
            <div class="col-md-6 col-lg-4">
                <div class="card card-outline h-100" 
                     data-event-id="{{id}}" 
                     style="cursor: pointer;"
                     onmouseover="this.style.transform='translateY(-3px)'"
                     onmouseout="this.style.transform=''">
                    <div class="card-header bg-transparent border-bottom-0 d-flex justify-content-between align-items-center pt-3 pb-0">
                        <span class="badge bg-warning" style="font-weight: 500; border-radius: 1rem; padding: 0.4rem 0.75rem; color: #212529;">
                            ⏳ На модерации
                        </span>
                        <span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.4rem 0.75rem;">
                            {{type_name}}
                        </span>
                    </div>
                    <div class="card-body position-relative">
                        <!-- Иконка кликабельности -->
                        <i class="bi bi-hand-index-thumb float-end text-muted opacity-50" style="font-size: 1.2rem;"></i>
                        <h5 class="card-title fw-semibold" style="color: var(--dark-gray, #172033);">{{title}}</h5>
                        <p class="card-text small text-muted">{{description}}</p>
                        <div class="small text-muted">
                            <div>📅 {{formatDate start_datetime}} — {{formatDate end_datetime}}</div>
                            <div>👤 Создал: {{creator_name}}</div>
                            <div>📍 {{location}}</div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0">
                        <div class="d-flex gap-2" onclick="event.stopPropagation();">
                            <form action="/events/moderation/{{id}}" method="POST" class="flex-grow-1">
                                <input type="hidden" name="action" value="approve">
                                <button type="submit" class="btn btn-success w-100 btn-sm fw-semibold">
                                    ✅ Утвердить
                                </button>
                            </form>
                            <button type="button" class="btn btn-danger btn-sm fw-semibold" onclick="rejectEvent({{id}}); event.stopPropagation();">
                                ❌ Отклонить
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="alert alert-success border-0 shadow-sm" style="border-radius: 0.75rem;">
        <h4 class="fw-semibold">✅ Все мероприятия проверены!</h4>
        <p class="mb-0">Нет мероприятий, ожидающих модерации.</p>
    </div>
{{/if}}

<script>
    function rejectEvent(eventId) {
        const reason = prompt('Укажите причину отклонения:');
        if (reason !== null) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/events/moderation/${eventId}`;
            
            const actionInput = document.createElement('input');
            actionInput.type = 'hidden';
            actionInput.name = 'action';
            actionInput.value = 'reject';
            
            const reasonInput = document.createElement('input');
            reasonInput.type = 'hidden';
            reasonInput.name = 'rejection_reason';
            reasonInput.value = reason || 'Без указания причины';
            
            form.appendChild(actionInput);
            form.appendChild(reasonInput);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
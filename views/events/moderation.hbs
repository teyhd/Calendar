<section class="app-page-head"><div><p class="app-page-kicker">Администрирование</p><h1 class="app-page-title">Модерация мероприятий</h1><p class="app-page-summary">Проверьте детали события перед утверждением. Решение действует в рамках текущих правил согласования.</p></div></section>
{{#if events.length}}
<section class="app-event-list" aria-label="Мероприятия на модерации">
    {{#each events}}
    <article class="app-event-row" data-event-id="{{id}}">
        <div><span class="app-event-title">{{title}}</span><span class="app-event-description">{{description}}</span></div>
        <div><span class="app-status app-status-waiting">Ожидает решения</span><span class="app-type">{{type_name}}</span></div>
        <div class="app-event-meta"><span>{{formatDate start_datetime}} — {{formatDate end_datetime}}</span><span>{{creator_name}}</span>{{#if approvals}}<span>Есть решения администраторов</span>{{/if}}</div>
        <div class="app-actions-row" onclick="event.stopPropagation()"><form action="/events/admin-approve/{{id}}" method="POST"><button type="submit" class="app-btn app-btn-primary app-btn-sm">Утвердить</button></form><button type="button" class="app-btn app-btn-danger app-btn-sm" onclick="openReasonModal({{id}}, 'reject')">Отклонить</button></div>
    </article>
    {{/each}}
</section>
{{else}}<section class="app-surface app-empty"><h2>Очередь пуста</h2><p>Все поступившие мероприятия уже рассмотрены.</p></section>{{/if}}

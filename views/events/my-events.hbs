<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    📋 Мои мероприятия
</h1>

{{#if events.length}}
    <div class="row g-4">
        {{#each events}}
            <div class="col-md-6 col-lg-4">
                <div class="card card-outline h-100" 
                     data-event-id="{{id}}" 
                     style="cursor: pointer;"
                     onmouseover="this.style.transform='translateY(-3px)'"
                     onmouseout="this.style.transform=''">
                    <div class="card-header bg-transparent border-bottom-0 d-flex justify-content-between align-items-center pt-3 pb-0">
                        <span class="badge" style="background-color: {{statusColor status}}; color: #fff; font-weight: 500; border-radius: 1rem; padding: 0.4rem 0.75rem;">
                            {{statusText status}}
                        </span>
                        <span class="badge bg-secondary" style="font-weight: 500; border-radius: 1rem; padding: 0.4rem 0.75rem;">
                            {{type_name}}
                        </span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-semibold" style="color: var(--dark-gray, #172033);">{{title}}</h5>
                        <p class="card-text small text-muted">{{description}}</p>
                        <div class="small text-muted">
                            <div>📅 {{formatDate start_datetime}}</div>
                            <div>📍 {{location}}</div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0">
                        <div class="d-grid">
                            {{#if (eq status "pending")}}
                                <a href="/events/edit/{{id}}" class="btn btn-primary btn-sm fw-semibold" onclick="event.stopPropagation();">
                                    ✏️ Редактировать
                                </a>
                            {{else}}
                                <span class="text-muted small text-center" style="font-size: 0.75rem;">Нажмите для просмотра</span>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="alert alert-info border-0 shadow-sm" style="border-radius: 0.75rem;">
        <p class="mb-2">У вас пока нет созданных мероприятий.</p>
        <a href="/events/create" class="btn btn-primary">➕ Создать мероприятие</a>
    </div>
{{/if}}
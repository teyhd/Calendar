<section class="app-page-head">
    <div><p class="app-page-kicker">Личный раздел</p><h1 class="app-page-title">Мои мероприятия</h1><p class="app-page-summary">Созданные вами события и их текущие статусы.</p></div>
    {{#if user.permissions.create_event}}<a class="app-btn app-btn-primary" href="/events/create">Создать мероприятие</a>{{/if}}
</section>

{{#if events.length}}
<section class="app-event-list" aria-label="Мои мероприятия">
    {{#each events}}
    <article class="app-event-row" data-event-id="{{id}}">
        <div><span class="app-event-title">{{title}}</span><span class="app-event-description">{{description}}</span></div>
        <div><span class="app-status app-status-{{#if (eq status "WAITING_ADMIN")}}waiting{{else if (eq status "APPROVED")}}approved{{else if (eq status "REJECTED")}}rejected{{else if (eq status "CANCELED")}}canceled{{else if (eq status "COMPLETED")}}completed{{else}}draft{{/if}}">{{statusText status}}</span><span class="app-type">{{type_name}}</span></div>
        <div class="app-event-meta"><span>{{formatDate start_datetime}}</span>{{#if location}}<span>{{location}}</span>{{/if}}</div>
        <div class="app-actions-row">
            {{#if (eq status "WAITING_ADMIN")}}<a class="app-btn app-btn-secondary app-btn-sm" href="/events/edit/{{id}}">Редактировать</a><button class="app-btn app-btn-danger app-btn-sm" type="button" onclick="openReasonModal({{id}}, 'delete')">Удалить</button>
            {{else if (eq status "APPROVED")}}{{#if ../user.permissions.moderate_event}}<button class="app-btn app-btn-danger app-btn-sm" type="button" onclick="openReasonModal({{id}}, 'cancel')">Отменить</button>{{/if}}{{/if}}
        </div>
    </article>
    {{/each}}
</section>
{{else}}
<section class="app-surface app-empty"><h2>Мероприятий пока нет</h2><p>Когда вы создадите событие, оно появится здесь.</p>{{#if user.permissions.create_event}}<a class="app-btn app-btn-primary" href="/events/create">Создать мероприятие</a>{{/if}}</section>
{{/if}}

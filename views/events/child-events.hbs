<section class="app-page-head"><div><p class="app-page-kicker">Семейный раздел</p><h1 class="app-page-title">Мероприятия ребёнка</h1><p class="app-page-summary">События, доступные вашим детям через школьное расписание.</p></div></section>
{{#if message}}<div class="app-alert">{{message}}</div>{{/if}}
{{#if events.length}}
<section class="app-event-list" aria-label="Мероприятия ребёнка">
    {{#each events}}<article class="app-event-row" data-event-id="{{id}}"><div><span class="app-event-title">{{title}}</span><span class="app-event-description">{{description}}</span></div><div><span class="app-status app-status-approved">{{statusText status}}</span><span class="app-type">{{type_name}}</span></div><div class="app-event-meta"><span>{{formatDate start_datetime}} — {{formatDate end_datetime}}</span>{{#if location}}<span>{{location}}</span>{{/if}}{{#if student_name}}<span>Участник: {{student_name}}</span>{{/if}}</div><div></div></article>{{/each}}
</section>
{{else}}<section class="app-surface app-empty"><h2>Событий пока нет</h2><p>Когда появятся подходящие мероприятия, они будут показаны здесь.</p></section>{{/if}}

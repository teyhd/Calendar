<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    ✏️ Редактирование мероприятия
</h1>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form action="/events/edit/{{event.id}}" method="POST" id="eventForm">
                    <!-- Основная информация -->
                    <div class="mb-3">
                        <label for="title" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Название *</label>
                        <input type="text" class="form-control" id="title" name="title" value="{{event.title}}" placeholder="Введите название мероприятия" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Описание</label>
                        <textarea class="form-control" id="description" name="description" rows="3" placeholder="Краткое описание мероприятия">{{event.description}}</textarea>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="event_type_id" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Тип мероприятия *</label>
                                <select class="form-select" id="event_type_id" name="event_type_id" required>
                                    <option value="">Выберите тип</option>
                                    {{#each types}}
                                        <option value="{{id}}" {{#if (eq ../event.event_type_id id)}}selected{{/if}}>{{name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="level" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Уровень</label>
                                <select class="form-select" id="level" name="level">
                                    <option value="school" {{#if (eq event.level "school")}}selected{{/if}}>🏫 Школьное</option>
                                    <option value="city" {{#if (eq event.level "city")}}selected{{/if}}>🏙️ Городское</option>
                                    <option value="regional" {{#if (eq event.level "regional")}}selected{{/if}}>🌍 Региональное</option>
                                    <option value="national" {{#if (eq event.level "national")}}selected{{/if}}>🇷🇺 Всероссийское</option>
                                    <option value="international" {{#if (eq event.level "international")}}selected{{/if}}>🌐 Международное</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="department_id" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Кафедра</label>
                                <select class="form-select" id="department_id" name="department_id">
                                    <option value="">Не выбрано</option>
                                    {{#each departments}}
                                        <option value="{{id}}" {{#if (eq ../event.department_id id)}}selected{{/if}}>{{name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="subject_id" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Предмет</label>
                                <select class="form-select" id="subject_id" name="subject_id">
                                    <option value="">Не выбрано</option>
                                    {{#each subjects}}
                                        <option value="{{id}}" {{#if (eq ../event.subject_id id)}}selected{{/if}} data-department="{{department_id}}">{{name}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="start_datetime" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Дата и время начала *</label>
                                <input type="datetime-local" class="form-control" id="start_datetime" name="start_datetime" value="{{formatDateForInput event.start_datetime}}" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="end_datetime" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Дата и время окончания *</label>
                                <input type="datetime-local" class="form-control" id="end_datetime" name="end_datetime" value="{{formatDateForInput event.end_datetime}}" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="location" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Место проведения</label>
                        <input type="text" class="form-control" id="location" name="location" value="{{event.location}}" placeholder="Например: Актовый зал, кабинет 301">
                    </div>
                    
                    <!-- Блок: Аудитория -->
                    <div class="block-outline mb-3">
                        <div class="card-header bg-transparent border-bottom-0 pt-2 pb-0 px-0">
                            <h6 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">👥 Кто увидит мероприятие?</h6>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label for="target_audience_type" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Тип аудитории *</label>
                                        <select class="form-select" id="target_audience_type" name="target_audience_type" required>
                                            <option value="class" {{#if (eq event.target_audience_type "class")}}selected{{/if}}>📚 Конкретный класс</option>
                                            <option value="parallel" {{#if (eq event.target_audience_type "parallel")}}selected{{/if}}>📖 Целая параллель</option>
                                            <option value="department" {{#if (eq event.target_audience_type "department")}}selected{{/if}}>🏛️ Кафедра</option>
                                            <option value="specific_users" {{#if (eq event.target_audience_type "specific_users")}}selected{{/if}}>👤 Конкретные пользователи</option>
                                            <option value="all" {{#if (eq event.target_audience_type "all")}}selected{{/if}}>🌍 Все пользователи</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6" id="audience_target_container">
                                    <!-- Выпадающий список для class, parallel, department -->
                                    <div id="select_audience_container" style="{{#if (eq event.target_audience_type "specific_users")}}display:none;{{/if}}">
                                        <label for="target_audience_id" class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Выберите аудиторию</label>
                                        <select class="form-select" id="target_audience_id" name="target_audience_id">
                                            <option value="">Выберите...</option>
                                            {{#each classes}}
                                                <option value="{{id}}" {{#if (eq ../event.target_audience_id id)}}selected{{/if}}>{{name}}</option>
                                            {{/each}}
                                        </select>
                                    </div>
                                    <!-- Блок: Конкретные пользователи (поиск + чипсы) -->
                                    <div id="specific_users_block" style="{{#if (eq event.target_audience_type "specific_users")}}display:block;{{else}}display:none;{{/if}}">
                                        <label class="form-label fw-semibold" style="color: var(--dark-gray, #172033);">Выберите пользователей</label>
                                        <div class="row g-2">
                                            <div class="col-12">
                                                <div class="input-group">
                                                    <input type="text" class="form-control" id="userSearchInput" placeholder="Начните вводить имя пользователя..." autocomplete="off">
                                                    <button class="btn btn-outline-secondary" type="button" id="clearSearchBtn">✕</button>
                                                </div>
                                                <div id="searchResults" class="list-group mt-1" style="display: none; max-height: 200px; overflow-y: auto; position: absolute; z-index: 1000; width: 100%;"></div>
                                            </div>
                                            <div class="col-12">
                                                <div id="selectedUsersContainer" class="d-flex flex-wrap gap-2 mt-2">
                                                    <!-- Здесь будут чипсы выбранных пользователей -->
                                                </div>
                                                <!-- Скрытое поле для хранения ID выбранных пользователей -->
                                                <input type="hidden" id="selectedUsersIds" name="target_audience_ids" value="">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Блок: Запись на мероприятие -->
                    <div class="block-outline mb-3">
                        <div class="card-header bg-transparent border-bottom-0 pt-2 pb-0 px-0">
                            <h6 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">📝 Запись на мероприятие</h6>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="form-check mb-3">
                                <input class="form-check-input form-check-input-lg" type="checkbox" id="is_registration_enabled" name="is_registration_enabled" value="1" {{#if event.is_registration_enabled}}checked{{/if}}>
                                <label class="form-check-label form-check-label-lg" for="is_registration_enabled">
                                    Участники могут записываться на это мероприятие
                                </label>
                                <div class="form-text text-muted small">
                                    Если включено, ученики и родители смогут нажать "Записаться" и отметиться о своём участии.
                                    Это полезно для мероприятий, где посещение необязательно и нужна аналитика.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Для администратора -->
                    {{#if (or (eq user.type 2) (eq user.type 5))}}
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="is_admin_event" name="is_admin_event" value="1" {{#if event.is_admin_event}}checked{{/if}}>
                        <label class="form-check-label" for="is_admin_event">
                            🔒 Только для администраторов (не видно ученикам и родителям)
                        </label>
                    </div>
                    {{/if}}
                    
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">✅ Сохранить изменения</button>
                        <a href="/" class="btn btn-secondary px-4 fw-semibold">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Подсказка справа -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 sticky-top" style="top: 1rem;">
            <div class="card-header bg-transparent border-bottom-0 pt-3">
                <h5 class="mb-0 fw-semibold" style="color: var(--dark-gray, #172033);">💡 Подсказка</h5>
            </div>
            <div class="card-body">
                <p><strong>Кто увидит мероприятие?</strong></p>
                <ul class="small">
                    <li><strong>📚 Класс</strong> — выберите конкретный класс (например, 5А)</li>
                    <li><strong>📖 Параллель</strong> — выберите номер параллели (например, 5 класс)</li>
                    <li><strong>🏛️ Кафедра</strong> — выберите кафедру (например, Математика)</li>
                    <li><strong>👤 Пользователи</strong> — выберите конкретного пользователя</li>
                    <li><strong>🌍 Все</strong> — увидят все пользователи системы</li>
                </ul>
                <hr>
                <p class="text-muted small">* — обязательные поля</p>
                <div class="alert alert-warning border-0 small">
                    ⚠️ После редактирования мероприятие снова отправляется на модерацию администратору.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ---------- АУДИТОРИЯ: переключение типов ----------
        const typeSelect = document.getElementById('target_audience_type');
        const selectContainer = document.getElementById('select_audience_container');
        const targetSelect = document.getElementById('target_audience_id');
        const specificUsersBlock = document.getElementById('specific_users_block');

        const classes = {{{json classes}}};
        const departments = {{{json departments}}};
        const allUsers = {{{json users}}};
        const initialSelectedIds = {{{json selectedIds}}} || []; // массив ID из сервера

        // ---------- ПОИСК И ЧИПСЫ ----------
        const searchInput = document.getElementById('userSearchInput');
        const resultsContainer = document.getElementById('searchResults');
        const selectedContainer = document.getElementById('selectedUsersContainer');
        const hiddenInput = document.getElementById('selectedUsersIds');

        let selectedUsers = [];

        // Предзаполнение из initialSelectedIds
        if (initialSelectedIds.length > 0) {
            initialSelectedIds.forEach(id => {
                const user = allUsers.find(u => u.id === id);
                if (user) selectedUsers.push(user);
            });
        }

        function roleText(type) {
            const roles = {1: 'Ученик', 2: 'Учитель', 5: 'Админ', 6: 'Родитель'};
            return roles[type] || 'Неизвестно';
        }

        function searchUsers(query) {
            if (!query.trim()) return [];
            const q = query.toLowerCase().trim();
            return allUsers.filter(u => u.name.toLowerCase().includes(q));
        }

        function renderResults(results) {
            resultsContainer.innerHTML = '';
            if (results.length === 0) {
                resultsContainer.style.display = 'none';
                return;
            }
            results.forEach(user => {
                const item = document.createElement('a');
                item.href = '#';
                item.className = 'list-group-item list-group-item-action';
                item.textContent = `${user.name} (${roleText(user.type)})`;
                item.dataset.id = user.id;
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    addUser(user);
                    searchInput.value = '';
                    resultsContainer.style.display = 'none';
                });
                resultsContainer.appendChild(item);
            });
            resultsContainer.style.display = 'block';
        }

        function addUser(user) {
            if (selectedUsers.some(u => u.id === user.id)) return;
            selectedUsers.push(user);
            renderChips();
            searchInput.value = '';
            resultsContainer.style.display = 'none';
            updateHiddenInput();
        }

        function removeUser(userId) {
            selectedUsers = selectedUsers.filter(u => u.id !== userId);
            renderChips();
            updateHiddenInput();
        }

        function renderChips() {
            selectedContainer.innerHTML = '';
            selectedUsers.forEach(user => {
                const chip = document.createElement('span');
                chip.className = 'badge bg-primary d-inline-flex align-items-center gap-1 p-2';
                chip.style.fontSize = '0.9rem';
                chip.innerHTML = `
                    ${user.name}
                    <span role="button" class="ms-1" style="cursor:pointer;" data-userid="${user.id}">&times;</span>
                `;
                chip.querySelector('span[data-userid]').addEventListener('click', function() {
                    removeUser(parseInt(this.dataset.userid));
                });
                selectedContainer.appendChild(chip);
            });
        }

        function updateHiddenInput() {
            const ids = selectedUsers.map(u => u.id);
            hiddenInput.value = ids.join(',');
        }

        // Инициализация чипсов при загрузке (если есть предзаполнение)
        if (selectedUsers.length > 0) {
            renderChips();
            updateHiddenInput();
        }

        // ---------- ОБРАБОТЧИКИ ПОИСКА ----------
        let timeoutId = null;
        searchInput.addEventListener('input', function() {
            const query = this.value;
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => {
                const results = searchUsers(query);
                renderResults(results);
            }, 200);
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#userSearchInput') && !e.target.closest('#searchResults')) {
                resultsContainer.style.display = 'none';
            }
        });

        document.getElementById('clearSearchBtn').addEventListener('click', function() {
            searchInput.value = '';
            resultsContainer.style.display = 'none';
            searchInput.focus();
        });

        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const results = searchUsers(this.value);
                if (results.length > 0) {
                    addUser(results[0]);
                    this.value = '';
                    resultsContainer.style.display = 'none';
                }
            }
        });

        // ---------- УПРАВЛЕНИЕ ВИДИМОСТЬЮ БЛОКА specific_users ----------
        function updateAudienceControls() {
            const type = typeSelect.value;
            if (type === 'specific_users') {
                selectContainer.style.display = 'none';
                specificUsersBlock.style.display = 'block';
            } else {
                selectContainer.style.display = 'block';
                specificUsersBlock.style.display = 'none';
                // Заполняем select для остальных типов
                targetSelect.innerHTML = '<option value="">Выберите...</option>';
                if (!type) {
                    targetSelect.innerHTML = '<option value="">Сначала выберите тип аудитории</option>';
                    return;
                }
                let options = [];
                if (type === 'class') {
                    options = classes.map(c => ({value: c.id, text: c.name}));
                } else if (type === 'parallel') {
                    const parallels = [...new Set(classes.map(c => c.name.replace(/-.*$/, '')))].sort();
                    options = parallels.map(p => ({value: p, text: `${p} класс`}));
                } else if (type === 'department') {
                    options = departments.map(d => ({value: d.id, text: d.name}));
                } else if (type === 'all') {
                    targetSelect.innerHTML = '<option value="">Все пользователи системы</option>';
                    return;
                }
                options.forEach(opt => {
                    const option = document.createElement('option');
                    option.value = opt.value;
                    option.textContent = opt.text;
                    // Если текущее значение совпадает с сохранённым – выделяем
                    const currentValue = targetSelect.dataset.currentValue;
                    if (currentValue && String(opt.value) === currentValue) {
                        option.selected = true;
                    }
                    targetSelect.appendChild(option);
                });
            }
        }

        // Сохраняем текущее значение select для восстановления при переключении (если есть)
        const currentSelectValue = targetSelect.value;
        if (currentSelectValue) {
            targetSelect.dataset.currentValue = currentSelectValue;
        }

        typeSelect.addEventListener('change', updateAudienceControls);
        // Инициализация при загрузке
        updateAudienceControls();
    });
</script>
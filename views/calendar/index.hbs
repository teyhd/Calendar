<section class="workspace-shell" id="workspaceRoot" aria-labelledby="workspaceTitle">
    <header class="app-page-head">
        <div>
            <h1 class="app-page-title" id="workspaceTitle">Календарь мероприятий</h1>
            <p class="app-page-summary" id="workspaceSummary">Все важные события и действия — в одном рабочем пространстве.</p>
        </div>
        <div class="app-actions-row" id="workspaceActions"></div>
    </header>

    <section class="workspace-overview" id="workspaceOverview" aria-label="Сводка"></section>
    <section class="workspace-content" id="workspaceContent" aria-live="polite" aria-busy="true"></section>
</section>
<div class="app-toast-region" id="toastRegion" aria-live="polite" aria-atomic="true"></div>

<script>window.workspaceInitialState = {{{json workspaceState}}};</script>

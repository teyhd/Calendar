{{#each workspaceNavigation}}
    <a class="{{../linkClass}}{{#if isActive}} is-active{{/if}}" href="{{href}}" data-workspace-view="{{view}}"{{#if isActive}} aria-current="page"{{/if}}>
        <span class="app-nav-icon" aria-hidden="true">{{#if (eq icon "calendar")}}▦{{else if (eq icon "users")}}◉{{else if (eq icon "bookmark")}}▣{{else if (eq icon "shield")}}◈{{else if (eq icon "archive")}}□{{else if (eq icon "star")}}★{{else if (eq icon "chart")}}▥{{else if (eq icon "upload")}}↑{{else if (eq icon "settings")}}⚙{{else}}●{{/if}}</span>
        <span>{{label}}</span>{{#if count}}<span class="app-nav-count">{{count}}</span>{{/if}}
    </a>
{{/each}}

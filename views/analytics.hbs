<section class="app-page-head"><div><p class="app-page-kicker">Отчётность</p><h1 class="app-page-title">Аналитика</h1><p class="app-page-summary">{{#if showAllData}}Сводные показатели по всем мероприятиям системы.{{else}}Показатели по вашим мероприятиям и кафедре.{{/if}}</p></div></section>

<section class="app-surface app-filter-bar" aria-label="Фильтры аналитики">
    <label class="app-field"><span class="app-label">Период</span><select class="app-select" id="period"><option value="week">Неделя</option><option value="month" selected>Месяц</option><option value="quarter">Квартал</option><option value="year">Год</option><option value="all">Всё время</option></select></label>
    <label class="app-field"><span class="app-label">Тип мероприятия</span><select class="app-select" id="eventType"><option value="all">Все типы</option>{{#each eventTypes}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
    {{#if showAllData}}<label class="app-field"><span class="app-label">Учитель</span><select class="app-select" id="teacherFilter"><option value="all">Все учителя</option>{{#each teachers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>{{/if}}
    <div class="app-field"><span class="app-label">&nbsp;</span><button class="app-btn app-btn-secondary" type="button" id="resetFiltersBtn">Сбросить</button></div>
</section>

<section class="app-stat-grid" aria-label="Ключевые показатели"><div class="app-stat"><span class="app-stat-label">Всего мероприятий</span><span class="app-stat-value" id="totalEvents">0</span></div><div class="app-stat"><span class="app-stat-label">Утверждено</span><span class="app-stat-value" id="approvedEvents">0</span></div><div class="app-stat"><span class="app-stat-label">Отклонено</span><span class="app-stat-value" id="rejectedEvents">0</span></div><div class="app-stat"><span class="app-stat-label">Участников</span><span class="app-stat-value" id="totalParticipants">0</span></div></section>

<section class="app-chart-grid app-section-gap">
    <article class="app-surface app-chart-panel"><h2>Активность педагогов</h2><canvas id="teachersChart" height="220"></canvas></article>
    <article class="app-surface app-chart-panel"><h2>Активность классов</h2><canvas id="classesChart" height="220"></canvas></article>
    <article class="app-surface app-chart-panel"><h2>Распределение по типам</h2><canvas id="typesChart" height="220"></canvas></article>
    <article class="app-surface app-chart-panel"><h2>Динамика мероприятий</h2><canvas id="timelineChart" height="220"></canvas></article>
</section>

<section class="app-chart-grid app-section-gap">
    <article class="app-surface app-chart-panel"><h2>Топ учеников</h2><div id="studentsTable" class="app-table-wrap"><p class="app-help">Загрузка…</p></div></article>
    <article class="app-surface app-chart-panel"><h2>Топ ответственных</h2><div id="responsibleTable" class="app-table-wrap"><p class="app-help">Загрузка…</p></div></article>
    <article class="app-surface app-chart-panel"><h2>Топ организаторов</h2><div id="organizersTable" class="app-table-wrap"><p class="app-help">Загрузка…</p></div></article>
</section>

<script src="/vendor/chart.js/chart.umd.js"></script>
<script src="/js/analytics.js"></script>

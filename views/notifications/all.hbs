<section class="app-page-head"><div><p class="app-page-kicker">Личный раздел</p><h1 class="app-page-title">Уведомления</h1><p class="app-page-summary">Системные сообщения о мероприятиях и действиях с ними.</p></div><div class="app-actions-row"><a href="/" class="app-btn app-btn-secondary">К календарю</a>{{#if allNotifications.length}}<form action="/notifications/mark-all-read" method="POST"><button type="submit" class="app-btn app-btn-primary">Отметить все прочитанными</button></form>{{/if}}</div></section>
{{#if allNotifications.length}}
<section class="app-event-list" aria-label="Все уведомления">
    {{#each allNotifications}}<article class="app-event-row"><div><span class="app-event-title">{{message}}</span><span class="app-event-description">{{formatDate created_at}}</span></div><div>{{#unless is_read}}<span class="app-status app-status-completed">Новое</span>{{else}}<span class="app-help">Прочитано</span>{{/unless}}</div><div></div><div>{{#unless is_read}}<button class="app-btn app-btn-secondary app-btn-sm mark-read-btn" type="button" data-id="{{id}}">Прочитано</button>{{/unless}}</div></article>{{/each}}
</section>
{{else}}<section class="app-surface app-empty"><h2>Уведомлений нет</h2><p>Новые сообщения будут показаны здесь.</p></section>{{/if}}
<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.mark-read-btn').forEach((button) => button.addEventListener('click', () => {
        fetch(`/notifications/mark-read/${encodeURIComponent(button.dataset.id)}`, { method: 'POST' })
            .then((response) => response.json()).then((data) => { if (data.success) window.location.reload(); else throw new Error('Не удалось обновить уведомление'); })
            .catch((error) => window.alert(error.message || 'Ошибка сервера'));
    }));
});
</script>

<h1 class="mb-4" style="font-size: 1.8rem; font-weight: 700; color: var(--dark-gray, #172033);">
    🔔 Все уведомления
</h1>

<div class="d-flex gap-2 mb-3 flex-wrap">
    <a href="/" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Назад
    </a>
    {{#if allNotifications.length}}
        <form action="/notifications/mark-all-read" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-all"></i> Пометить все как прочитанные
            </button>
        </form>
    {{/if}}
</div>

{{#if allNotifications.length}}
    <div class="row g-3">
        {{#each allNotifications}}
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1 me-3">
                            <p class="mb-1" style="color: var(--dark-gray);">{{this.message}}</p>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">{{formatDate this.created_at}}</small>
                                {{#unless this.is_read}}
                                    <span class="badge bg-primary" style="font-weight: 500; border-radius: 1rem; padding: 0.3rem 0.6rem;">Новое</span>
                                {{/unless}}
                            </div>
                        </div>
                        {{#unless this.is_read}}
                            <button class="btn btn-sm btn-outline-primary mark-read-btn" data-id="{{this.id}}" title="Пометить прочитанным">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        {{/unless}}
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
{{else}}
    <div class="alert alert-info border-0 shadow-sm" style="border-radius: 0.75rem;">
        <p class="mb-0">У вас нет уведомлений.</p>
    </div>
{{/if}}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.mark-read-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                fetch(`/notifications/mark-read/${id}`, { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Ошибка при пометке уведомления');
                        }
                    })
                    .catch(error => {
                        console.error('Ошибка:', error);
                        alert('Ошибка сервера');
                    });
            });
        });
    });
</script>
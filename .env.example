# Calendar domain database (read/write only to this database)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=calendar

# Read-only SSO directory connection (SELECT on sso.* only)
SSO_DB_HOST=
SSO_DB_PORT=3306
SSO_DB_USER=
SSO_DB_PASSWORD=
SSO_DB_NAME=sso

# MainPortal SSO client
SSO_BASE_URL=https://platoniks.ru/sso
SSO_CLIENT_ID=calendar
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://event.platoniks.ru/api/cb
SSO_SERVICE_ID=
JWT_SECRET=
AUTH_SESSION_SECRET=
AUTH_SESSION_COOKIE_NAME=calendar.sid
AUTH_SESSION_TTL=8h

# Google Calendar OAuth. Keep all values only in .env or the process environment.
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://event.platoniks.ru/integrations/google-calendar/callback
# 32 random bytes encoded as base64; for rotation use v1:<base64>,v2:<base64>.
GOOGLE_TOKEN_ENCRYPTION_KEYS=
GOOGLE_SYNC_DEFAULT_INTERVAL_MINUTES=60

NODE_ENV=production
HOST=127.0.0.1
PORT=3031
